# --- GIHM-HIS API ---
# Development database (SQLite). Production targets PostgreSQL:
#   DATABASE_URL="postgresql://gihm:gihm@localhost:5432/gihm?schema=public"
# and change `provider` in prisma/schema.prisma to "postgresql" (schema is portable).
DATABASE_URL="file:./dev.db"

# JWT signing secret — replace with a strong secret in any non-demo environment.
JWT_SECRET="dev-only-secret-change-me-ghm-his-2026"

# API port
PORT=4000

# CORS origin for the web app in development
WEB_ORIGIN="http://localhost:5173"

# --- SMS reminders (Ghana) -----------------------------------------------
# These are the BOOT DEFAULTS. Every value below (including API keys) can be
# edited at runtime from Administration → Settings (docs/24) — once saved there,
# the database value wins over this file, with no restart needed.
# Copy the block for your provider into the local .env and uncomment to enable
# live dispatch:
#   SMS_PROVIDER=smsonlinegh     # SMSOnlineGH | hubtel | twilio | unset → inferred or off
#   SMSONLINEGH_API_KEY=your_api_token
#   SMSONLINEGH_SENDER_ID=YourSenderName   # REQUIRED for live sends — must be a
#                                          # sender ID registered to your SMSOnlineGH
#                                          # account (else DS_REJECTED_SENDER_UNREGISTERED)
#   SMSONLINEGH_CALLBACK_URL=https://yourserver/api/v1/immunizations/reminders/delivery-callback
#   SMSONLINEGH_CALLBACK_TOKEN=shared-secret   # optional — the webhook requires
#                                              # this via x-callback-token / ?token= when set
#   # Endpoint: POST https://api.smsonlinegh.com/v5/message/sms/send
#   #   Authorization: key <api key>  (note: "key ", not Bearer)
#   #   Body: { text, type: 0, sender, destinations: [...] }
#   # Verified live: handshake HSHK_OK + batch/message ids returned; delivery
#   # status is push-only via the callback above (no polling API).
#
#   SMS_PROVIDER=hubtel          # Hubtel alternative
#   HUBTEL_CLIENT_ID=your_client_id
#   HUBTEL_CLIENT_SECRET=your_client_secret
#   HUBTEL_SENDER_ID=HM          # registered sender ID (HM = Hubtel test mode)
#   # Endpoint: GET https://smsc.hubtel.com/v1/messages/send?clientid&clientsecret&from&to&content
#
#   SMS_PROVIDER=twilio          # Twilio alternative
#   TWILIO_ACCOUNT_SID=... / TWILIO_AUTH_TOKEN=... / TWILIO_PHONE_NUMBER=...

# --- WhatsApp --------------------------------------------------------------
# Channel=WHATSAPP reminders, provider-aware. Hubtel (default) and SMSOnlineGH:
#   WHATSAPP_PROVIDER=hubtel
#   HUBTEL_WHATSAPP_URL=https://api.wa.hubtel.com/v1/messages/send
#   HUBTEL_WHATSAPP_CLIENT_ID=       # falls back to HUBTEL_CLIENT_ID
#   HUBTEL_WHATSAPP_CLIENT_SECRET=   # falls back to HUBTEL_CLIENT_SECRET
#   HUBTEL_WHATSAPP_SENDER_ID=HM
# Verify the Hubtel WhatsApp endpoint for your account (docs change); Hubtel
# SMS-mode senders use HM.
#
#   WHATSAPP_PROVIDER=smsonlinegh
#   # Reuses SMSONLINEGH_API_KEY + SMSONLINEGH_SENDER_ID. Endpoint is
#   # env-configurable (SMSONLINEGH_WHATSAPP_URL) because SMSOnlineGH's public
#   # docs don't document WhatsApp — verify it supports WhatsApp on your account
#   # (unverified; unsupported accounts reject at the gateway, audit-logged).

# --- Auto reminder sweep -------------------------------------------------
# Scheduled recalls for children due/overdue within the window, deduped by the
# audit look-back. Runs shortly after boot, then on the interval:
#   REMINDER_JOB_ENABLED=true
#   REMINDER_JOB_INTERVAL_MINUTES=1440
#   REMINDER_JOB_WINDOW_DAYS=7
#   REMINDER_JOB_LOOKBACK_DAYS=7
# Manual trigger: POST /api/v1/immunizations/reminders/run

# --- Application ----------------------------------------------------------
#   TIMEZONE=Africa/Accra            # display timezone (applied live)
#   WEB_ORIGIN=http://localhost:5173 # CORS allow-list, comma-separated
#   PORT=4000                        # API port (restart-scoped)
#   JWT_SECRET=change-me             # signing secret (restart-scoped)

# --- Editable reminder message templates (admin UI overrides these) ------
# Placeholders: {patientName} {description} {dose} {dueDate}
#   REMINDER_MSG_DUE="Dear {patientName}, your child is due for {description} ({dose}) on {dueDate}. Please visit the health facility."
#   REMINDER_MSG_OVERDUE="Dear {patientName}, your child is overdue for {description} ({dose}). Please visit the health facility soon."

# --- Security policy (developer, docs/25) --------------------------------
# Applied globally and immediately; editable in Developer Mode > Security.
#   PASSWORD_MIN_LENGTH=8
#   LOGIN_LOCKOUT_THRESHOLD=5
#   SESSION_TTL_HOURS=12

# --- Licensing (developer, docs/25) ---------------------------------------
# Activate a license in Developer Mode > Licensing (these are only the boot
# defaults). With no license the system runs unlicensed/trial.
#   LICENSE_EDITION=COMMUNITY
#   LICENSE_KEY=
#   LICENSE_EXPIRY=
#   LICENSE_MAX_FACILITIES=
#   LICENSE_MAX_USERS=

# --- National integrations (docs/08 §3) ----------------------------------
# DHIMS2 (monthly indicator datasets), SORMAS (disease case events),
# GhiLMIS (logistics — monthly commodity stock-level snapshots) and HRIMS
# (workforce — monthly staff register snapshots) each keep an independent
# delivery queue; unset = submissions queue and status reports "not
# configured". Local clinical operations never depend on these being up.
#   INTEGRATION_DHIMS2_URL=https://dhims2.example.gh
#   INTEGRATION_DHIMS2_USERNAME=user
#   INTEGRATION_DHIMS2_PASSWORD=secret
#   INTEGRATION_SORMAS_URL=https://sormas.example.gh
#   INTEGRATION_SORMAS_USERNAME=user
#   INTEGRATION_SORMAS_PASSWORD=secret
#   INTEGRATION_GHILMIS_URL=https://ghilmis.example.gh
#   INTEGRATION_GHILMIS_USERNAME=user
#   INTEGRATION_GHILMIS_PASSWORD=secret
#   INTEGRATION_HRIMS_URL=https://hrims.example.gh
#   INTEGRATION_HRIMS_USERNAME=user
#   INTEGRATION_HRIMS_PASSWORD=secret
#   INTEGRATION_SWEEP_INTERVAL_MINUTES=1
#   INTEGRATION_MAX_ATTEMPTS=5
#   INTEGRATION_BATCH=10
