// =====================================================================
// GIHM-HIS — Core data model
// ---------------------------------------------------------------------
// Design notes (see docs/03-database-erd.md and docs/15-offline-sync-architecture.md):
//  * Development datasource is SQLite (zero-infra). The schema is written to be
//    portable: production switches `provider` to "postgresql" (one line) — no
//    SQLite-only types are used (no enums/Json/Decimal; coded values are strings
//    validated by the API layer).
//  * Offline-first (spec §100): every client-generated write carries
//    clientTimestamp + idempotencyKey, and a MutationLog records the transaction.
//  * Append-oriented clinical data (spec §102): encounters/notes/orders/prescriptions
//    are appended; nothing is silently overwritten. Every entity has createdAt/updatedAt.
//  * Stable identifiers (spec §86): UUID primary keys; names/phones are never keys.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // production: "postgresql" (see docs/17-cloud-deployment-architecture.md)
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Administrative geography (spec §4, §5) — configurable master data
// ---------------------------------------------------------------------

model Region {
  id            String     @id @default(uuid())
  code          String     @unique // e.g. "GA" (Greater Accra)
  name          String     @unique
  capital       String?
  gpsLat        Float?
  gpsLng        Float?
  status        String     @default("ACTIVE") // ACTIVE | INACTIVE
  effectiveDate DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  districts District[]
  facilities Facility[]
  patients   Patient[]
  users      User[]
  facilityApplications FacilityApplication[]
}

model District {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. "GA-ACC-METRO"
  name      String
  type      String   // METROPOLITAN | MUNICIPAL | DISTRICT (GSS classification)
  capital   String?
  regionId  String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region       Region       @relation(fields: [regionId], references: [id])
  facilities   Facility[]
  patients     Patient[]
  users        User[]
  subDistricts SubDistrict[]
  communities  Community[]
  facilityApplications FacilityApplication[]

  @@unique([regionId, name])
}

model SubDistrict {
  id         String   @id @default(uuid())
  name       String
  districtId String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  district   District     @relation(fields: [districtId], references: [id])
  communities Community[]
}

model Community {
  id           String   @id @default(uuid())
  name         String
  districtId   String?
  subDistrictId String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  district    District?    @relation(fields: [districtId], references: [id])
  subDistrict SubDistrict? @relation(fields: [subDistrictId], references: [id])
}

// ---------------------------------------------------------------------
// Organizations / tenants (spec §7)
// ---------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  type      String   // GOVERNMENT | GHS | TEACHING_HOSPITAL | PRIVATE | CHAG_MISSION | QUASI_GOVT | NGO
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  users     User[]
  facilities Facility[]
}

// ---------------------------------------------------------------------
// Facilities (spec §6) — national facility registry
// ---------------------------------------------------------------------

model Facility {
  id               String   @id @default(uuid())
  code             String   @unique // e.g. "GH-KBTH"
  name             String
  type             String   // CHPS_COMPOUND | HEALTH_CENTRE | CLINIC | MATERNITY_HOME | POLYCLINIC | DISTRICT_HOSPITAL | MUNICIPAL_HOSPITAL | REGIONAL_HOSPITAL | TEACHING_HOSPITAL | UNIVERSITY_HOSPITAL | PSYCHIATRIC_HOSPITAL | SPECIALIST_HOSPITAL | PRIVATE_HOSPITAL | MISSION_HOSPITAL | QUASI_GOVT_HOSPITAL | LABORATORY | PHARMACY | DIAGNOSTIC_CENTRE | REHABILITATION_FACILITY | OTHER
  level            String?  // PRIMARY | SECONDARY | TERTIARY
  ownership        String   // GOVERNMENT | GHS | MOH | TEACHING_HOSPITAL | CHAG_MISSION | PRIVATE | QUASI_GOVT | NGO | OTHER
  organizationId   String?
  regionId         String
  districtId       String
  address          String?
  gpsLat           Float?
  gpsLng           Float?
  telephone        String?
  email            String?
  website          String?
  emergencyContact String?
  operationalStatus String  @default("OPERATIONAL") // OPERATIONAL | TEMPORARILY_CLOSED | UNDER_CONSTRUCTION | INACTIVE | SUSPENDED
  accreditation    String?  // ACCREDITED | PENDING_ACCREDITATION | null
  bedCapacity      Int?
  openingHours     String   @default("{}") // JSON: {"mon-fri":"08:00-17:00",...}
  services         String   @default("[]") // JSON array of service codes
  departmentsJson  String   @default("[]") // JSON array of department names
  isSynthetic      Boolean  @default(false) // true = DEMO/SYNTHETIC DATA (spec §155)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  region       Region        @relation(fields: [regionId], references: [id])
  district     District      @relation(fields: [districtId], references: [id])
  users        User[]
  patients     Patient[]
  appointments Appointment[]
  devices      Device[]
  departments  Department[]
  stockItems   StockItem[]
  stockMovements StockMovement[]
  beds         Bed[]
  referrals    Referral[]
  ambulances   Ambulance[]
  ambulanceTrips AmbulanceTrip[] @relation("TripDestination")
  bloodDonations BloodDonation[]
  bloodUnits   BloodUnit[]
  transfusions TransfusionRecord[]
  bloodDonors  BloodDonor[]
  surgicalBookings SurgicalBooking[]
  emergencyCases EmergencyCase[]
  carePlans    CarePlan[]
  nursingObservations NursingObservation[]
  medicationAdministrations MedicationAdministration[]
  antenatalVisits AntenatalVisit[]
  deliveryRecords DeliveryRecord[]
  postnatalVisits PostnatalVisit[]
  partographs   Partograph[]
  teleconsultations Teleconsultation[]
  imagingOrders ImagingOrder[]
  suppliers    Supplier[]
  requisitions Requisition[]
  purchaseOrders PurchaseOrder[]
  units        HospitalUnit[]
  equipment    UnitEquipment[]
  staff        Staff[]
  nationalService NationalServiceStaff[]
  insuranceClaims InsuranceClaim[]
  assets       Asset[]
  diseaseCases DiseaseCase[]
  admissions   Admission[]
}

model Department {
  id           String   @id @default(uuid())
  name         String
  facilityId   String
  queueEnabled Boolean  @default(true)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id])
  units    HospitalUnit[]
}

// Per-department ticket counter (queue). Allocation must be atomic: a load
// test caught the old count+1 allocator racing under parallel check-ins
// (P2002 on the (facilityId, departmentId, ticket) unique), so each ticket
// number comes from a single row via an atomic UPDATE — no two check-ins can
// ever observe the same number.
model QueueSequence {
  id           String @id @default(uuid())
  departmentId String @unique
  value        Int    @default(0)

  @@map("QueueSequence")
}

// ---------------------------------------------------------------------
// Hospital units (Department → Unit → Ward → Bed) — the physical and
// organisational structure of a facility: an Intensive Care Unit, a
// Maternity Unit, a Dialysis Unit, … each with an in-charge, contact and
// its own wards (which in turn hold beds). Units sit under a Department
// (the queue/anatomy anchor) but may also exist without one.
// ---------------------------------------------------------------------

model HospitalUnit {
  id           String   @id @default(uuid())
  facilityId   String
  departmentId String?
  code         String   // e.g. "ICU", "NICU", "MAT-ANTE" — unique per facility
  name         String   // e.g. "Intensive Care Unit"
  type         String   @default("CLINICAL") // CLINICAL | DIAGNOSTIC | SUPPORT | ADMINISTRATIVE
  headName     String?  // head of unit / unit in-charge
  headTitle    String?  // e.g. "Consultant Physician"
  phone        String?  // unit contact / extension
  location     String?  // e.g. "Block A, 3rd Floor"
  bedCapacity  Int?
  services     String   @default("[]") // JSON array of service codes
  notes        String?
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facility   Facility   @relation(fields: [facilityId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  wards      Ward[]
  beds       Bed[]
  admissions Admission[]
  equipment  UnitEquipment[]
  staff      Staff[]
  nationalService NationalServiceStaff[]

  @@unique([facilityId, code])
}

model Ward {
  id          String   @id @default(uuid())
  unitId      String
  name        String
  bedCapacity Int?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit       HospitalUnit @relation(fields: [unitId], references: [id])
  beds       Bed[]
  admissions Admission[]

  @@unique([unitId, name])
}

// ---------------------------------------------------------------------
// Unit equipment & tools (Department → Unit → Equipment). Every unit's
// inventory of medical devices and instruments — a ventilator in the ICU, an
// anaesthesia machine in theatre, a dialysis machine in the renal unit — with
// the functional / in-maintenance / faulty breakdown, serial tracking and
// scheduled maintenance. Status is DERIVED from the counts (never stored):
// all functional → OPERATIONAL, mixed → PARTIAL, all in maintenance →
// IN_MAINTENANCE, all faulty → FAULTY.
// ---------------------------------------------------------------------

model UnitEquipment {
  id                String    @id @default(uuid())
  unitId            String
  facilityId        String
  name              String
  category          String    @default("SUPPORT") // LIFE_SUPPORT | MONITORING | DIAGNOSTIC | SURGICAL | THERAPY | SUPPORT | OTHER
  quantity          Int       @default(1)
  functional        Int       @default(0)
  inMaintenance     Int       @default(0)
  faulty            Int       @default(0)
  serialNumber      String?
  manufacturer      String?
  model             String?
  purchaseDate      DateTime?
  lastMaintenanceAt DateTime?
  nextMaintenanceAt DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  unit           HospitalUnit         @relation(fields: [unitId], references: [id])
  facility       Facility             @relation(fields: [facilityId], references: [id])
  maintenanceLog EquipmentMaintenance[]

  @@unique([unitId, name])
}

model EquipmentMaintenance {
  id            String    @id @default(uuid())
  equipmentId   String
  performedAt   DateTime  @default(now())
  performedById String?
  note          String?
  createdAt     DateTime  @default(now())

  equipment   UnitEquipment @relation(fields: [equipmentId], references: [id])
  performedBy User?         @relation(fields: [performedById], references: [id])
}

// ---------------------------------------------------------------------
// Staff & teams (Department → Unit → Staff) — the hospital workforce: every
// employee on the payroll (clinical cadres and support roles) with the unit
// they work in, licence registration numbers, employment status and the
// head-of-unit flag. Staff are the structured counterpart to the free-text
// headName/headTitle on HospitalUnit — a unit's roster is derived here.
// ---------------------------------------------------------------------

model Staff {
  id               String    @id @default(uuid())
  facilityId       String
  unitId           String?
  staffNumber      String    // e.g. "KBTH-0142" — unique per facility
  fullName         String
  role             String    // CONSULTANT | MEDICAL_OFFICER | NURSE | MIDWIFE | PHARMACIST | ...
  speciality       String?   // e.g. "Cardiology", "Neonatology", "Anaesthesia"
  licenseNumber    String?   // GMC / NMC / PCN / GHS registration
  phone            String?
  email            String?
  employmentStatus String    @default("ACTIVE") // ACTIVE | ON_LEAVE | RETIRED | TERMINATED
  headOfUnit       Boolean   @default(false)
  joinedAt         DateTime?
  notes            String?
  // Linked login account (docs/25): a staff record may have exactly one user
  // account — created from the directory with the role auto-mapped (doctor
  // → DOCTOR, nurse → NURSE, …). The link lets the directory show who can
  // actually log in, and keeps the two views of the workforce in sync.
  userId           String?   @unique
  isSynthetic      Boolean   @default(false) // true = DEMO/SYNTHETIC DATA (spec §155)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  facility Facility      @relation(fields: [facilityId], references: [id])
  unit     HospitalUnit? @relation(fields: [unitId], references: [id])
  user     User?         @relation(fields: [userId], references: [id])

  @@unique([facilityId, staffNumber])
  @@index([unitId])
}

// ---------------------------------------------------------------------
// National Service personnel (Ghana National Service Scheme) — young
// graduates posted to the facility for their service year. Tracked
// separately from salaried staff: same facility/unit placement, but with
// their posting institution, programme and service-year dates.
// ---------------------------------------------------------------------
model NationalServiceStaff {
  id          String   @id @default(uuid())
  facilityId  String
  unitId      String?
  nssNumber   String   // e.g. "NSS-2026-0001" — unique per facility
  fullName    String
  institution String?  // university / college posted from
  programme   String?  // course of study, e.g. "BSc Nursing"
  placement   String?  // role/placement note, e.g. "Ward nurse support"
  supervisor  String?  // supervising staff member name
  phone       String?
  email       String?
  startDate   DateTime
  endDate     DateTime?
  status      String   @default("ACTIVE") // ACTIVE | COMPLETED | TERMINATED
  notes       String?
  isSynthetic Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility Facility      @relation(fields: [facilityId], references: [id])
  unit     HospitalUnit? @relation(fields: [unitId], references: [id])

  @@unique([facilityId, nssNumber])
  @@index([unitId])
}

// ---------------------------------------------------------------------
// Fixed assets (spec §39) — the facility asset register: buildings, motor
// vehicles, IT, plant/utilities and furniture. Unlike unit equipment (the
// clinical devices a unit owns), assets are the facility-level fixed assets
// with straight-line depreciation. Book value is DERIVED on read from
// purchaseCost − (age / usefulLifeYears × depreciable base) — never stored,
// so an edit to cost/life/salvage recomputes the whole schedule.
// ---------------------------------------------------------------------

model Asset {
  id              String    @id @default(uuid())
  facilityId      String
  assetNumber     String    // e.g. "KBTH-0001" — unique per facility
  name            String
  category        String    @default("OTHER") // BUILDING | VEHICLE | IT | MEDICAL | PLANT | FURNITURE | OTHER
  description     String?
  serialNumber    String?
  manufacturer    String?
  model           String?
  acquisitionDate DateTime  @default(now())
  purchaseCost    Float
  salvageValue    Float     @default(0)
  usefulLifeYears Int       @default(5)
  location        String?   // e.g. "Block A, 2nd Floor"
  custodianName   String?   // department / officer responsible
  status          String    @default("ACTIVE") // ACTIVE | IN_STORAGE | DISPOSED
  disposedAt      DateTime?
  disposalNote    String?
  notes           String?
  isSynthetic     Boolean   @default(false) // true = DEMO/SYNTHETIC DATA (spec §155)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, assetNumber])
  @@index([category])
  @@index([status])
}

// ---------------------------------------------------------------------
// Identity & access (spec §61, §62)
// ---------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  code        String   @unique // NATIONAL_ADMIN | REGIONAL_DIRECTOR | DISTRICT_DIRECTOR | HOSPITAL_ADMIN | MEDICAL_DIRECTOR | DOCTOR | NURSE | MIDWIFE | PHARMACIST | LAB_SCIENTIST | RADIOLOGIST | RADIOGRAPHER | HEALTH_INFO_OFFICER | RECORDS_OFFICER | ACCOUNTANT | CASHIER | STOREKEEPER | PROCUREMENT_OFFICER | HR_OFFICER | IT_ADMIN | AMBULANCE_OFFICER | COMMUNITY_HEALTH_WORKER | PATIENT | ...
  name        String
  scope       String   // NATIONAL | REGIONAL | DISTRICT | FACILITY | PATIENT
  permissions String   @default("[]") // JSON array of permission codes (spec §62)
  createdAt   DateTime @default(now())

  users User[]
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  roleId       String
  organizationId String?
  facilityId   String?
  regionId     String?
  districtId   String?
  status       String    @default("ACTIVE") // ACTIVE | SUSPENDED | LOCKED
  isSynthetic  Boolean   @default(true)
  lastLoginAt  DateTime?
  // Login security (docs/25): failed attempts before lockout, and when a
  // threshold lock expires (null = manually locked — no auto-unlock).
  failedLoginAttempts Int     @default(0)
  lockedUntil         DateTime?
  // Session revocation (docs/25): bump this counter to invalidate all existing JWTs.
  tokenVersion        Int     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role         Role          @relation(fields: [roleId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  facility     Facility?     @relation(fields: [facilityId], references: [id])
  region       Region?       @relation(fields: [regionId], references: [id])
  district     District?     @relation(fields: [districtId], references: [id])
  patient      Patient?
  staff        Staff?
  appointments Appointment[] @relation("AppointmentClinician")
  devices      Device[]      @relation("DeviceUser")
  scheduledReports ScheduledReport[]
  surgeriesAsSurgeon      SurgicalBooking[] @relation("TheatreSurgeon")
  surgeriesAsAnaesthetist SurgicalBooking[] @relation("TheatreAnaesthetist")
  emergencyTriaged EmergencyCase[] @relation("EmergencyTriager")
  emergencyStaff  EmergencyCase[] @relation("EmergencyStaff")
  carePlansCreated CarePlan[]
  observationsRecorded NursingObservation[]
  medsAdministered MedicationAdministration[]
  purchaseOrdersIssued PurchaseOrder[]
  requisitionsRequested Requisition[] @relation("ReqRequestedBy")
  requisitionsApproved Requisition[] @relation("ReqApprovedBy")
  equipmentMaintenance EquipmentMaintenance[]
  insuranceVerified PatientInsurance[] @relation("InsuranceVerifiedBy")
  insuranceSubmitted InsuranceClaim[] @relation("ClaimSubmittedBy")
  insuranceDecided  InsuranceClaim[] @relation("ClaimDecidedBy")
  diseaseCasesReported DiseaseCase[] @relation("DiseaseCaseReporter")
  caseFollowUps         CaseFollowUp[] @relation("CaseFollowUpBy")
  admissionsAsConsultant Admission[] @relation("AdmissionConsultant")
  admissionsAsAttending  Admission[] @relation("AdmissionAttending")
  uploadedDocuments PatientDocument[] @relation("PatientDocumentUploader")
  teleconsultations Teleconsultation[] @relation("TeleconsultationClinician")
}

// ---------------------------------------------------------------------
// Patients & Master Patient Index (spec §11, §12, §13)
// ---------------------------------------------------------------------

// Monotonic MRN counter (docs/15 §4). Allocation must be atomic: a load test
// caught concurrent registrations racing the old count-based allocator
// (P2002 / "Could not allocate a medical record number" under parallel
// creates), so the next MRN is taken from a single counter row via an atomic
// UPDATE — no two requests can ever observe the same number.
model PatientSequence {
  id    String @id @default(uuid())
  key   String @unique // "patient" — the only row today
  value Int    @default(0)

  @@map("PatientSequence")
}

model Patient {
  id          String   @id @default(uuid())
  mrn         String   @unique // Medical record number, e.g. "GH-000123"
  fullName    String
  formerName  String?
  dateOfBirth DateTime?
  sex         String?  // M | F
  maritalStatus String?
  occupation  String?
  nationality String   @default("Ghanaian")
  phone       String?
  email       String?
  preferredLanguage String @default("EN") // EN | TW | EE | GA | HA | DA | FR — for reminder/outreach messaging
  regionId    String?
  districtId  String?
  facilityId  String?
  community   String?
  address     String?
  ghanaCard   String?
  nhisNumber  String?
  passport    String?
  birthCertificate String?
  // Patient photograph (admission-form checklist): one ID photo per record,
  // stored on disk (uploads/patients/<patientId>/photo.<ext>) with the path
  // kept here; served only through the authenticated photo endpoint.
  photoStoredName String?
  bloodGroup  String?
  genotype    String?
  allergies   String   @default("[]") // JSON array
  emergencyContactName String?
  emergencyContactPhone String?
  nextOfKinName  String?
  nextOfKinPhone String?
  consentAccepted Boolean @default(false)
  consentRecordedAt DateTime?
  // ---- Admission-form identification (Ghana hospital admission form) ----
  patientType  String   @default("GHANAIAN") // GHANAIAN | FOREIGN | REFUGEE | OTHER
  preferredName String?
  countryOfBirth String?
  placeOfBirth  String?
  passportIssueDate DateTime?
  passportExpiryDate DateTime?
  visaPermitType String?  // TOURIST | STUDENT | WORK | RESIDENCE | DIPLOMATIC | OTHER
  visaPermitNumber String?
  visaPermitExpiry DateTime?
  countryOfResidence String?
  permanentAddress String?
  internationalInsurer String?
  internationalPolicyNumber String?
  interpreterRequired Boolean @default(false)
  interpreterLanguage String?
  preferredContactMethod String? // PHONE | SMS | WHATSAPP | EMAIL
  rhesus         String?  // POSITIVE | NEGATIVE | UNKNOWN
  // Next of kin / guardian / employer / clinical history (admission form)
  nextOfKinRelationship String?
  nextOfKinAlternativePhone String?
  nextOfKinAddress String?
  emergencyContactSameAsNok Boolean @default(true)
  emergencyContactRelationship String?
  parentGuardianName String?
  parentGuardianRelationship String?
  parentGuardianPhone String?
  parentGuardianIdNumber String?
  parentGuardianAddress String?
  employer String?
  employerAddress String?
  employerPhone String?
  school String?
  currentMedications String?
  previousConditions String @default("[]") // JSON array
  previousSurgeries String?
  previousAdmissionsText String?
  // Patient preference: never send reminder recalls (SMS/WhatsApp) for this
  // record — the reminder sweep, single remind, bulk and remind-all all skip
  // opted-out patients and count them in the summary (docs/23).
  reminderOptOut Boolean @default(false)
  isSynthetic Boolean  @default(true)
  status      String   @default("ACTIVE") // ACTIVE | MERGED | INACTIVE
  mergedIntoId String? // set when this record was merged into another (MPI §12)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?        @unique
  region      Region?        @relation(fields: [regionId], references: [id])
  district    District?      @relation(fields: [districtId], references: [id])
  facility    Facility?      @relation(fields: [facilityId], references: [id])
  user        User?          @relation(fields: [userId], references: [id])
  mergedInto  Patient?       @relation("PatientMergedInto", fields: [mergedIntoId], references: [id])
  mergedFrom  Patient[]      @relation("PatientMergedInto")

  identifiers  PatientIdentifier[]
  contacts     PatientContact[]
  appointments Appointment[]
  encounters   Encounter[]
  labOrders    LabOrder[]
  prescriptions Prescription[]
  admissions   Admission[]
  referrals    Referral[]
  invoices     Invoice[]
  insuranceMemberships PatientInsurance[]
  insuranceClaims InsuranceClaim[]
  immunizations Immunization[]
  diseaseCases DiseaseCase[]
  queueEntries QueueEntry[]
  mergesAsSource PatientMerge[] @relation("MergeSource")
  mergesAsTarget PatientMerge[] @relation("MergeTarget")
  beds         Bed[]
  ambulanceTrips AmbulanceTrip[]
  bloodDonor   BloodDonor[]
  transfusions TransfusionRecord[]
  unitsIssued  BloodUnit[]     @relation("UnitIssuedPatient")
  unitsCrossmatched BloodUnit[] @relation("UnitCrossmatchPatient")
  surgeries    SurgicalBooking[]
  emergencyCases EmergencyCase[]
  carePlans    CarePlan[]
  nursingObservations NursingObservation[]
  medicationAdministrations MedicationAdministration[]
  antenatalVisits AntenatalVisit[]
  deliveryRecords DeliveryRecord[]
  postnatalVisits PostnatalVisit[]
  partographs     Partograph[]
  teleconsultations Teleconsultation[]
  imagingOrders   ImagingOrder[]
  documents       PatientDocument[]
}

// ---------------------------------------------------------------------
// Digital patient folder (docs/10 data governance) — a per-patient document
// store completing the record: scanned Ghana Cards, NHIS cards, passports,
// referral letters, lab results, discharge summaries and other clinical
// paperwork. Files live on disk (uploads/patients/<patientId>/<docId>.<ext>),
// are served only through authenticated endpoints, and every action is
// audit-logged (patient.document.upload / .update / .delete).
// ---------------------------------------------------------------------

model PatientDocument {
  id           String   @id @default(uuid())
  patientId    String
  category     String   @default("OTHER") // GHANA_CARD | NHIS_CARD | PASSPORT | VISA_PERMIT | IDENTITY | REFERRAL_LETTER | LAB_RESULT | IMAGING | PRESCRIPTION | DISCHARGE_SUMMARY | CONSENT | INSURANCE | MEDICAL_RECORD | OTHER
  originalName String
  storedName   String   @unique // relative path under the uploads root, e.g. patients/<patientId>/<docId>.pdf
  mimeType     String
  sizeBytes    Int
  notes        String?
  uploadedById String?
  createdAt    DateTime @default(now())

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("PatientDocumentUploader", fields: [uploadedById], references: [id])

  @@index([patientId, createdAt])
  @@index([category])
}

/**
 * MPI merge audit record (spec §12): every merge stores the moved entity ids so
 * the merge can be reversed (unmerge) with a complete audit trail. Never silent.
 */
model PatientMerge {
  id               String   @id @default(uuid())
  sourcePatientId  String // patient whose records were merged away
  targetPatientId  String // surviving patient
  sourceMrn        String
  targetMrn        String
  reason           String?
  movedEntities    String   @default("{}") // JSON: {"encounters":[ids],"labOrders":[ids],...}
  mergedById       String?
  mergedAt         DateTime @default(now())
  unmergedAt       DateTime?
  unmergedById     String?
  unmergeReason    String?

  source Patient @relation("MergeSource", fields: [sourcePatientId], references: [id])
  target Patient @relation("MergeTarget", fields: [targetPatientId], references: [id])
}

model PatientIdentifier {
  id        String   @id @default(uuid())
  patientId String
  type      String   // GHANA_CARD | NHIS | PASSPORT | BIRTH_CERTIFICATE | FACILITY_NUMBER | OTHER
  value     String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([patientId, type, value])
}

model PatientContact {
  id        String   @id @default(uuid())
  patientId String
  kind      String   // PHONE | EMAIL | ADDRESS
  value     String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

// ---------------------------------------------------------------------
// Appointments & queue (spec §14, §15)
// ---------------------------------------------------------------------

model Appointment {
  id            String    @id @default(uuid())
  patientId     String
  facilityId    String?
  departmentId  String?
  clinicianId   String?
  service       String?
  reason        String?
  scheduledFor  DateTime
  status        String    @default("BOOKED") // BOOKED | CONFIRMED | CHECKED_IN | COMPLETED | CANCELLED | MISSED
  idempotencyKey String?  @unique
  clientTimestamp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient   Patient     @relation(fields: [patientId], references: [id])
  facility  Facility?   @relation(fields: [facilityId], references: [id])
  clinician User?       @relation("AppointmentClinician", fields: [clinicianId], references: [id])
}

model QueueEntry {
  id           String   @id @default(uuid())
  facilityId   String
  departmentId String
  patientId    String?
  ticket       String   // e.g. "OPD-014"
  status       String   @default("WAITING") // WAITING | CALLED | IN_SERVICE | COMPLETED | SKIPPED
  createdAt    DateTime @default(now())
  calledAt     DateTime?
  servedAt     DateTime?

  patient Patient? @relation(fields: [patientId], references: [id])

  @@unique([facilityId, departmentId, ticket])
}

// ---------------------------------------------------------------------
// Clinical (spec §16-§21, §23, §25) — append-oriented
// ---------------------------------------------------------------------

model Encounter {
  id            String   @id @default(uuid())
  patientId     String
  facilityId    String?
  departmentId  String?
  type          String   // OPD | EMERGENCY | INPATIENT | ANTENATAL | IMMUNIZATION | OTHER
  status        String   @default("OPEN") // OPEN | TRIAGED | IN_PROGRESS | COMPLETED
  clinicianId   String?
  presentingComplaint String?
  // Triage / vitals (spec §17)
  temperature   Float?
  pulse         Int?
  respiratoryRate Int?
  systolicBp    Int?
  diastolicBp   Int?
  spo2          Float?
  weightKg      Float?
  heightCm      Float?
  painScore     Int?
  triageCategory String? // NON_URGENT | URGENT | EMERGENT
  diagnosisSummary String?
  idempotencyKey String? @unique
  clientTimestamp DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient      Patient        @relation(fields: [patientId], references: [id])
  notes        ClinicalNote[]
  diagnoses    Diagnosis[]
  labOrders    LabOrder[]
  imagingOrders ImagingOrder[]
  prescriptions Prescription[]
  carePlans    CarePlan[]
  nursingObservations NursingObservation[]
}

model ImagingOrder {
  id               String   @id @default(uuid())
  patientId        String
  encounterId      String
  facilityId       String?
  modality         String   // X_RAY | ULTRASOUND | CT | MRI | MAMMOGRAPHY | FLUOROSCOPY | OTHER
  bodyPart         String?
  clinicalQuestion String?
  status           String   @default("ORDERED") // ORDERED | IN_PROGRESS | REPORTED | VERIFIED | CANCELLED
  report           String?  // radiologist findings
  impression       String?  // radiologist impression
  requestedById    String?
  reportedById     String?
  idempotencyKey   String?  @unique
  clientTimestamp  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient   Patient   @relation(fields: [patientId], references: [id])
  encounter Encounter @relation(fields: [encounterId], references: [id])
  facility  Facility? @relation(fields: [facilityId], references: [id])

  @@index([status])
}

model ClinicalNote {
  id          String   @id @default(uuid())
  encounterId String
  authorId    String?
  noteType    String   // NURSING | DOCTOR | PROGRESS | DISCHARGE | TRIAGE
  note        String
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])
}

model Diagnosis {
  id          String   @id @default(uuid())
  encounterId String
  code        String   // ICD-10 code
  description String
  type        String   @default("PRIMARY") // PRIMARY | SECONDARY | DIFFERENTIAL
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])
}

model LabOrder {
  id            String   @id @default(uuid())
  encounterId   String
  patientId     String
  facilityId    String?
  test          String
  discipline    String   // HAEMATOLOGY | CHEMISTRY | MICROBIOLOGY | SEROLOGY | PATHOLOGY | BLOOD_BANK
  status        String   @default("ORDERED") // ORDERED | COLLECTED | RESULTED | VERIFIED | CANCELLED
  sampleType    String?
  result        String?
  referenceRange String?
  critical      Boolean  @default(false)
  requestedById String?
  verifiedById  String?
  resultNote    String?
  idempotencyKey String? @unique
  clientTimestamp DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])
}

model Prescription {
  id            String   @id @default(uuid())
  encounterId   String
  patientId     String
  facilityId    String?
  medicine      String
  dosage        String?
  frequency     String?
  duration      String?
  quantity      Int?
  route         String?
  status        String   @default("ACTIVE") // ACTIVE | DISPENSED | PARTIAL | CANCELLED
  dispensedQty  Int?
  prescribedById String?
  dispensedById String?
  idempotencyKey String? @unique
  clientTimestamp DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])
  administrations MedicationAdministration[]
}

model Admission {
  id              String    @id @default(uuid())
  patientId       String
  facilityId      String?
  unitId          String?
  wardId          String?
  ward            String?
  bed             String?
  admittedAt      DateTime  @default(now())
  dischargedAt    DateTime?
  status          String    @default("ADMITTED") // ADMITTED | DISCHARGED | TRANSFERRED
  reason          String?
  dischargeSummary String?
  createdAt       DateTime  @default(now())

  // ---- Ghana hospital admission form (digital) ----
  admissionNumber String?   // ADM-2026-0001 (per facility); null for quick bed allocations
  admissionType   String?   // EMERGENCY | OPD_TO_IPD | ELECTIVE | REFERRAL | MATERNITY | SURGICAL | MEDICAL | OTHER
  source          String?   // HOME | EMERGENCY_DEPT | CLINIC | HOSPITAL | AMBULANCE | OTHER
  referringFacility String?
  referringDoctor String?
  chiefComplaint  String?
  provisionalDiagnosis String?
  identificationPending Boolean @default(false)
  consultantId    String?
  attendingDoctorId String?
  nurseReceiving  String?
  admissionVitals String?   // JSON: {temperature,pulse,respiratoryRate,systolicBp,diastolicBp,spo2,weightKg,heightCm}
  paymentMethod   String?   // NHIS | PRIVATE_INSURANCE | CORPORATE | CASH | MOMO | BANK_CARD | SPONSOR | OTHER
  billingAccount  String?
  insurerName     String?
  policyNumber    String?
  authorizationNumber String?
  // Maternity (where applicable)
  pregnant        Boolean?
  edd             DateTime?
  gravida         Int?
  parity          Int?
  lmp             DateTime?
  consentSigned   Boolean   @default(false)
  consentSignedAt DateTime?
  dischargeNote   String?
  transferNote    String?
  transferredAt   DateTime?
  transferHistory String    @default("[]") // JSON array of {fromWard, fromBed, toWard, toBed, note, at, by}

  patient Patient       @relation(fields: [patientId], references: [id])
  facility Facility?    @relation(fields: [facilityId], references: [id])
  unit    HospitalUnit? @relation(fields: [unitId], references: [id])
  wardRow Ward?         @relation(fields: [wardId], references: [id])
  consultant  User?     @relation("AdmissionConsultant", fields: [consultantId], references: [id])
  attending   User?     @relation("AdmissionAttending", fields: [attendingDoctorId], references: [id])

  @@index([facilityId, admittedAt])
  @@unique([facilityId, admissionNumber])
}

model Referral {
  id            String   @id @default(uuid())
  patientId     String
  fromFacilityId String
  toFacilityId  String?
  toFacilityName String?
  specialty     String?
  urgency       String   @default("ROUTINE") // ROUTINE | URGENT | EMERGENCY
  summary       String?
  status        String   @default("SUBMITTED") // DRAFT | SUBMITTED | RECEIVED | ACCEPTED | REJECTED | AWAITING_TRANSPORT | IN_TRANSIT | ARRIVED | COMPLETED | RETURNED | CANCELLED
  // Wired workflow (roadmap §164 quick win): transition notes, timestamps and
  // the ambulance assigned to transport the patient.
  note          String?
  receivedAt    DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  arrivedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  ambulanceId   String?
  ambulance     Ambulance? @relation("ReferralAmbulance", fields: [ambulanceId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient  Patient   @relation(fields: [patientId], references: [id])
  facility Facility? @relation(fields: [fromFacilityId], references: [id])
}

// ---------------------------------------------------------------------
// Finance (spec §37) — billing demo
// ---------------------------------------------------------------------

model Invoice {
  id            String   @id @default(uuid())
  patientId     String
  facilityId    String?
  encounterId   String?
  items         String   @default("[]") // JSON array of {description, amount}
  amount        Float
  paidAmount    Float    @default(0)
  status        String   @default("UNPAID") // UNPAID | PARTIAL | PAID | EXEMPT
  paymentMethod String?  // CASH | MOMO | CARD | BANK | INSURANCE | CORPORATE | EXEMPT
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  patient      Patient         @relation(fields: [patientId], references: [id])
  paymentAttempts PaymentAttempt[]
}

// ---------------------------------------------------------------------
// Payment provider abstraction (spec §37 — never hard-code one provider).
// Each attempt is idempotent (idempotencyKey) and records the provider ref
// so a confirmation callback can be matched to the attempt. The invoice's
// paidAmount/status are updated only from a confirmed SUCCESS attempt.
// ---------------------------------------------------------------------

// ---------------------------------------------------------------------
// Platform event webhooks (docs/22 Phase 7 — advanced interoperability).
// External systems subscribe to platform events (patient.created,
// labOrder.verified, immunization.administered, delivery.recorded) and
// receive signed POSTs with retry; deliveries are durable and surfaced.
// ---------------------------------------------------------------------

model WebhookSubscription {
  id          String   @id @default(uuid())
  name        String
  url         String
  events      String   @default("[]") // JSON array of event names ("*" = all)
  secret      String   // shared secret used to HMAC-sign deliveries
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([active])
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  subscriptionId String
  event          String
  payload        String    // JSON as sent (signed with the subscription secret)
  status         String    @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([status])
  @@index([subscriptionId])
}

model PaymentAttempt {
  id            String    @id @default(uuid())
  invoiceId     String
  provider      String    // SIMULATED | MOMO | CARD | …
  providerRef   String
  amount        Float
  status        String    @default("PENDING") // PENDING | SUCCESS | FAILED
  idempotencyKey String   @unique
  initiatedById String?
  checkoutUrl   String?
  error         String?
  initiatedAt   DateTime  @default(now())
  confirmedAt   DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

// ---------------------------------------------------------------------
// Insurance & claims (spec §38) — the insurer registry, patient memberships
// and claim lifecycle. Schemes are NATIONAL master data (NHIS + private +
// corporate insurers); memberships link a patient to a scheme with validity
// and NHIS e-verification; claims track what the facility bills the insurer,
// from SUBMITTED → APPROVED / PARTIALLY_APPROVED / REJECTED → PAID.
// ---------------------------------------------------------------------

model InsuranceScheme {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "NHIS", "NATIONWIDE", "GLICO"
  name        String
  type        String   @default("NHIS") // NHIS | PRIVATE | CORPORATE
  phone       String?
  email       String?
  notes       String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  isSynthetic Boolean  @default(false) // true = DEMO/SYNTHETIC DATA (spec §155)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships PatientInsurance[]
  claims      InsuranceClaim[]
}

model PatientInsurance {
  id               String    @id @default(uuid())
  patientId        String
  schemeId         String
  membershipNumber String    // NHIS card / insurer membership number
  holderName       String?   // when the member is not the patient (dependants)
  relationship     String    @default("SELF") // SELF | SPOUSE | CHILD | DEPENDENT
  validFrom        DateTime  @default(now())
  validTo          DateTime?
  status           String    @default("ACTIVE") // ACTIVE | EXPIRED | SUSPENDED | CANCELLED
  verified         Boolean   @default(false) // NHIS e-verification (or manual confirm)
  verifiedAt       DateTime?
  verifiedById     String?
  notes            String?
  isSynthetic      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  patient    Patient         @relation(fields: [patientId], references: [id])
  scheme     InsuranceScheme @relation(fields: [schemeId], references: [id])
  verifiedBy User?           @relation("InsuranceVerifiedBy", fields: [verifiedById], references: [id])

  @@unique([patientId, schemeId])
  @@index([validTo])
}

model InsuranceClaim {
  id             String   @id @default(uuid())
  claimNumber    String   // e.g. "CLM-2026-0001" — per-facility yearly sequence
  patientId      String
  schemeId       String
  facilityId     String
  invoiceId      String?
  encounterId    String?
  serviceDate    DateTime @default(now())
  items          String   @default("[]") // JSON array {description, amount}
  amount         Float
  approvedAmount Float?
  status         String   @default("SUBMITTED") // SUBMITTED | APPROVED | PARTIALLY_APPROVED | REJECTED | PAID
  submittedById  String?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  isSynthetic    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient     Patient         @relation(fields: [patientId], references: [id])
  scheme      InsuranceScheme @relation(fields: [schemeId], references: [id])
  facility    Facility        @relation(fields: [facilityId], references: [id])
  submittedBy User?           @relation("ClaimSubmittedBy", fields: [submittedById], references: [id])
  decidedBy   User?           @relation("ClaimDecidedBy", fields: [decidedById], references: [id])

  @@unique([facilityId, claimNumber])
  @@index([status])
  @@index([facilityId])
}

// ---------------------------------------------------------------------
// Public health (spec §22, §46, §52)
// ---------------------------------------------------------------------

model Immunization {
  id           String   @id @default(uuid())
  patientId    String
  facilityId   String?
  vaccine      String   // BCG | OPV | PENTA | PCV | ROTA | MEASLES_RUBELLA | YF | HPV | TT | COVID19 | OTHER
  dose         String
  administeredAt DateTime
  nextDueAt    DateTime?
  batch        String?
  vaccinatorId String?
  status       String   @default("GIVEN") // GIVEN | MISSED | DUE
  createdAt    DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model DiseaseCase {
  id          String    @id @default(uuid())
  patientId   String?
  facilityId  String
  reporterId  String?
  disease     String
  caseType    String    // SUSPECTED | CONFIRMED
  severity    String?   // MILD | MODERATE | SEVERE | CRITICAL
  status      String    @default("OPEN") // OPEN | INVESTIGATED | CLOSED
  outcome     String?   // RECOVERED | DECEASED | STABLE | REFERRED | null
  notes       String?
  isSynthetic Boolean   @default(false) // true = DEMO/SYNTHETIC DATA (spec §155)
  reportedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  patient  Patient?      @relation(fields: [patientId], references: [id])
  facility Facility?     @relation(fields: [facilityId], references: [id])
  reporter User?         @relation("DiseaseCaseReporter", fields: [reporterId], references: [id])
  followUps CaseFollowUp[]

  @@index([facilityId, reportedAt])
  @@index([disease])
  @@index([status])
}

// Contact tracing + case management follow-ups (spec §36 surveillance): each
// follow-up records the patient's current condition, a temperature reading and
// how many close contacts were traced since the last visit — the data public
// health teams use to control outbreaks.
model CaseFollowUp {
  id             String   @id @default(uuid())
  caseId         String
  byId           String?
  followUpAt     DateTime @default(now())
  status         String   // STABLE | IMPROVING | WORSENING | RECOVERED | DECEASED
  temperature    Float?
  contactsTraced Int      @default(0)
  notes          String?
  isSynthetic    Boolean  @default(false)
  createdAt      DateTime @default(now())

  case DiseaseCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  by   User?       @relation("CaseFollowUpBy", fields: [byId], references: [id])

  @@index([caseId])
}

// ---------------------------------------------------------------------
// Inventory & logistics (spec §25, §26) — health commodities with min/max
// stock, batch/expiry and a full movement audit trail.
// ---------------------------------------------------------------------

model StockItem {
  id           String   @id @default(uuid())
  facilityId   String
  name         String
  category     String   @default("MEDICINE") // MEDICINE | SUPPLY | REAGENT | VACCINE | OTHER
  unit         String   @default("unit") // tablet | vial | sachet | box | pack | bottle
  quantity     Int      @default(0)
  minStock     Int      @default(10)
  maxStock     Int      @default(500)
  reorderLevel Int      @default(20)
  batch        String?
  expiryDate   DateTime?
  location     String?
  status       String   @default("ACTIVE") // ACTIVE | DISCONTINUED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facility  Facility        @relation(fields: [facilityId], references: [id])
  movements StockMovement[]

  @@unique([facilityId, name])
}

model StockMovement {
  id            String   @id @default(uuid())
  stockItemId   String
  type          String   // RECEIPT | ISSUE | ADJUSTMENT | RETURN | WASTAGE
  quantity      Int
  balanceAfter  Int
  note          String?
  performedById String?
  createdAt     DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id])
  facility  Facility  @relation(fields: [facilityId], references: [id])
  facilityId String
}

// ---------------------------------------------------------------------
// Inpatient beds (spec §18) — ward bed board with status and occupancy.
// ---------------------------------------------------------------------

model Bed {
  id          String   @id @default(uuid())
  facilityId  String
  unitId      String?
  wardId      String?
  ward        String
  bedNumber   String
  status      String   @default("AVAILABLE") // AVAILABLE | OCCUPIED | RESERVED | CLEANING | MAINTENANCE | ISOLATION
  patientId   String?
  admissionId String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility Facility      @relation(fields: [facilityId], references: [id])
  patient  Patient?      @relation(fields: [patientId], references: [id])
  unit     HospitalUnit? @relation(fields: [unitId], references: [id])
  wardRow  Ward?         @relation(fields: [wardId], references: [id])

  @@unique([facilityId, ward, bedNumber])
}

// ---------------------------------------------------------------------
// Ambulance management (spec §33) — registry, dispatch and trip lifecycle.
// ---------------------------------------------------------------------

model Ambulance {
  id             String   @id @default(uuid())
  facilityId     String
  registration   String   // e.g. "GV-1234-25"
  model          String?
  type           String   @default("AMBULANCE") // AMBULANCE | RAPID_RESPONSE | HEARSE
  status         String   @default("AVAILABLE") // AVAILABLE | ASSIGNED | EN_ROUTE | AT_SCENE | TRANSPORTING | AT_FACILITY | RETURNING | MAINTENANCE | OFFLINE
  driverName     String?
  driverPhone    String?
  crewNames      String   @default("[]") // JSON array
  gpsLat         Float?
  gpsLng         Float?
  fuelLevel      Int?
  odometerKm     Int?
  lastMaintenanceAt DateTime?
  nextMaintenanceAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  facility  Facility       @relation(fields: [facilityId], references: [id])
  trips     AmbulanceTrip[]
  referrals Referral[]      @relation("ReferralAmbulance")
}

model AmbulanceTrip {
  id                  String   @id @default(uuid())
  ambulanceId         String
  patientId           String?
  dispatchedById      String?
  status              String   @default("ASSIGNED") // ASSIGNED | EN_ROUTE | AT_SCENE | TRANSPORTING | AT_FACILITY | COMPLETED | CANCELLED
  emergencyType       String?  // MEDICAL | TRAUMA | OBSTETRIC | CARDIAC | OTHER
  pickupLocation      String?
  pickupLat           Float?
  pickupLng           Float?
  destinationFacilityId String?
  notes               String?
  dispatchedAt        DateTime @default(now())
  arrivedAtScene      DateTime?
  departedSceneAt     DateTime?
  arrivedAtFacility   DateTime?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ambulance Ambulance @relation(fields: [ambulanceId], references: [id])
  patient   Patient?  @relation(fields: [patientId], references: [id])
  destination Facility? @relation("TripDestination", fields: [destinationFacilityId], references: [id])
}

// ---------------------------------------------------------------------
// Blood bank (spec §27) — donors, donations, inventory units, transfusions.
// ---------------------------------------------------------------------

model BloodDonor {
  id             String   @id @default(uuid())
  facilityId     String
  patientId      String?
  fullName       String
  sex            String?
  dateOfBirth    DateTime?
  phone          String?
  bloodGroup     String   // O+ | A+ | B+ | AB+ | O- | A- | B- | AB-
  genotype       String?
  status         String   @default("ACTIVE") // ACTIVE | DEFERRED | INACTIVE
  lastDonationAt DateTime?
  totalDonations Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  facility  Facility         @relation(fields: [facilityId], references: [id])
  patient   Patient?         @relation(fields: [patientId], references: [id])
  donations BloodDonation[]
}

model BloodDonation {
  id               String   @id @default(uuid())
  donorId          String
  facilityId       String
  bloodGroup       String
  volumeMl         Int      @default(450)
  screeningResult  String?  // NEGATIVE | REACTIVE | PENDING
  unitsCreated     Int      @default(1)
  donatedAt        DateTime @default(now())
  createdAt        DateTime @default(now())

  donor    BloodDonor @relation(fields: [donorId], references: [id])
  facility Facility   @relation(fields: [facilityId], references: [id])
  units    BloodUnit[]
}

model BloodUnit {
  id                String   @id @default(uuid())
  donationId        String?
  facilityId        String
  unitCode          String   @unique // e.g. "BL-2026-0001"
  bloodGroup        String
  component         String   @default("WHOLE_BLOOD") // WHOLE_BLOOD | RED_CELLS | PLASMA | PLATELETS | CRYOPRECIPITATE
  status            String   @default("AVAILABLE") // AVAILABLE | RESERVED | CROSSMATCHED | ISSUED | EXPIRED | DISCARDED
  expiryDate        DateTime
  collectedAt       DateTime @default(now())
  issuedAt          DateTime?
  issuedToPatientId String?
  crossmatchPatientId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  donation     BloodDonation?     @relation(fields: [donationId], references: [id])
  facility     Facility           @relation(fields: [facilityId], references: [id])
  issuedPatient Patient?          @relation("UnitIssuedPatient", fields: [issuedToPatientId], references: [id])
  crossmatchPatient Patient?      @relation("UnitCrossmatchPatient", fields: [crossmatchPatientId], references: [id])
  transfusions TransfusionRecord[]
}

model TransfusionRecord {
  id               String   @id @default(uuid())
  unitId           String
  patientId        String
  facilityId       String
  crossmatchResult String?  // COMPATIBLE | INCOMPATIBLE
  startedAt        DateTime?
  completedAt      DateTime?
  reaction         String?  // adverse reaction notes
  performedById    String?
  status           String   @default("CROSSMATCHED") // CROSSMATCHED | IN_PROGRESS | COMPLETED | REACTION
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  unit     BloodUnit @relation(fields: [unitId], references: [id])
  patient  Patient   @relation(fields: [patientId], references: [id])
  facility Facility  @relation(fields: [facilityId], references: [id])
}

// ---------------------------------------------------------------------
// Theatre / surgery (spec §28) — bookings, consent and case progression.
// ---------------------------------------------------------------------

model SurgicalBooking {
  id               String   @id @default(uuid())
  patientId        String
  facilityId       String
  procedure        String
  theatre          String?
  surgeonId        String?
  anaesthetistId   String?
  urgency          String   @default("ROUTINE") // ROUTINE | URGENT | EMERGENCY
  status           String   @default("BOOKED") // BOOKED | SCHEDULED | PRE_OP | IN_PROGRESS | RECOVERY | COMPLETED | CANCELLED
  scheduledFor     DateTime?
  consentObtained  Boolean  @default(false)
  consentDate      DateTime?
  consentNote      String?
  preOpAssessment  String?
  intraOpNotes     String?
  postOpNotes      String?
  complications    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient      Patient     @relation(fields: [patientId], references: [id])
  facility     Facility    @relation(fields: [facilityId], references: [id])
  surgeon      User?       @relation("TheatreSurgeon", fields: [surgeonId], references: [id])
  anaesthetist User?       @relation("TheatreAnaesthetist", fields: [anaesthetistId], references: [id])
}

// ---------------------------------------------------------------------
// Emergency department (spec §19) — rapid registration, triage, disposition.
// ---------------------------------------------------------------------

model EmergencyCase {
  id                  String   @id @default(uuid())
  patientId           String
  facilityId          String
  arrivedAt           DateTime @default(now())
  modeOfArrival       String   @default("WALK_IN") // WALK_IN | AMBULANCE | TRANSFER
  presentingComplaint String?
  triageCategory      String?  // NON_URGENT | URGENT | EMERGENT | RESUSCITATION
  triageScore         Int?
  temperature         Float?
  pulse               Int?
  respiratoryRate     Int?
  systolicBp          Int?
  diastolicBp         Int?
  spo2                Float?
  painScore           Int?
  trauma              Boolean  @default(false)
  resuscitation       Boolean  @default(false)
  status              String   @default("WAITING") // WAITING | TRIAGED | IN_PROGRESS | ADMITTED | DISCHARGED | REFERRED | DEATH
  disposition         String?  // ADMITTED | DISCHARGED | REFERRED
  dispositionNote     String?
  triagedById         String?
  staffId             String?
  dischargedAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patient  Patient  @relation(fields: [patientId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])
  triagedBy User?   @relation("EmergencyTriager", fields: [triagedById], references: [id])
  staff     User?   @relation("EmergencyStaff", fields: [staffId], references: [id])
}

// ---------------------------------------------------------------------
// Nursing (spec §29) — care plans, observations and medication admin (MAR).
// ---------------------------------------------------------------------

model CarePlan {
  id            String   @id @default(uuid())
  patientId     String
  facilityId    String
  encounterId   String?
  diagnosis     String
  goals         String   @default("[]") // JSON array
  interventions String   @default("[]") // JSON array
  reviewDate    DateTime?
  status        String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient   Patient   @relation(fields: [patientId], references: [id])
  facility  Facility  @relation(fields: [facilityId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])
}

model NursingObservation {
  id          String   @id @default(uuid())
  patientId   String
  facilityId  String
  encounterId String?
  type        String   // VITALS | FLUID_INPUT | FLUID_OUTPUT | GLUCOSE | PAIN | OTHER
  value       String   // e.g. "118/76", "500ml"
  note        String?
  recordedById String?
  observedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  patient   Patient   @relation(fields: [patientId], references: [id])
  facility  Facility  @relation(fields: [facilityId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])
  recordedBy User?    @relation(fields: [recordedById], references: [id])
}

model MedicationAdministration {
  id             String   @id @default(uuid())
  patientId      String
  facilityId     String
  prescriptionId String?
  medicine       String
  dose           String?
  route          String?
  administeredAt DateTime @default(now())
  givenById      String?
  status         String   @default("GIVEN") // GIVEN | REFUSED | OMITTED
  note           String?
  createdAt      DateTime @default(now())

  patient      Patient       @relation(fields: [patientId], references: [id])
  facility     Facility      @relation(fields: [facilityId], references: [id])
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  givenBy      User?         @relation(fields: [givenById], references: [id])
}

// ---------------------------------------------------------------------
// Maternity & obstetrics (spec §20) — ANC, delivery and postnatal.
// ---------------------------------------------------------------------

model AntenatalVisit {
  id              String   @id @default(uuid())
  patientId       String
  facilityId      String?
  visitNumber     Int      @default(1)
  gaWeeks         Int?
  edd             DateTime?
  weightKg        Float?
  systolicBp      Int?
  diastolicBp     Int?
  fundalHeight    Float?
  fetalHeartRate  Int?
  riskAssessment  String?  // LOW | HIGH
  supplements     String?
  nextVisitAt     DateTime?
  status          String   @default("ACTIVE") // ACTIVE | DELIVERED | LOST
  visitedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id])
  facility Facility? @relation(fields: [facilityId], references: [id])
}

model DeliveryRecord {
  id               String   @id @default(uuid())
  patientId        String
  facilityId       String?
  deliveryType     String   @default("NORMAL") // NORMAL | ASSISTED | CAESAREAN
  mode             String?  // VAGINAL | INSTRUMENTAL | C_SECTION
  outcome          String?  // LIVE_BIRTH | STILLBIRTH
  birthWeightKg    Float?
  apgar1           Int?
  apgar5           Int?
  complications    String?
  maternalOutcome  String?  // WELL | COMPLICATION | DEATH
  newbornOutcome   String?  // WELL | NICU | DEATH
  placentaComplete Boolean  @default(true)
  attendedByName   String?
  deliveredAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id])
  facility Facility? @relation(fields: [facilityId], references: [id])
}

model PostnatalVisit {
  id            String   @id @default(uuid())
  patientId     String
  facilityId    String?
  visitNumber   Int      @default(1)
  maternalReview  String?
  newbornReview   String?
  breastfeeding String?  // EXCLUSIVE | MIXED | NONE
  contraception String?
  immunization  String?
  followUpAt    DateTime?
  visitedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id])
  facility Facility? @relation(fields: [facilityId], references: [id])
}

// ---------------------------------------------------------------------
// Labour partograph (spec §20, docs/13 §7) — the WHO-style labour chart:
// one partograph per labour episode, with repeated time-point observations
// (cervical dilation, fetal heart rate, contractions, descent). The server
// computes each observation's position against the alert/action lines
// (expected dilation = 4cm + 1cm/hour since labour onset; action line 4
// hours behind the alert line) so the UI can flag prolonged labour.
// ---------------------------------------------------------------------

model Partograph {
  id              String   @id @default(uuid())
  patientId       String
  facilityId      String?
  labourStartedAt DateTime
  status          String   @default("ACTIVE") // ACTIVE | COMPLETE
  notes           String?
  createdAt       DateTime @default(now())

  patient       Patient                @relation(fields: [patientId], references: [id])
  facility      Facility?              @relation(fields: [facilityId], references: [id])
  observations  PartographObservation[]

  @@index([patientId])
}

model PartographObservation {
  id                     String   @id @default(uuid())
  partographId           String
  observedAt             DateTime @default(now())
  cervicalDilationCm     Float?
  fetalHeartRateBpm      Int?
  contractionsPer10Min   Int?
  contractionDurationSec Int?
  descentFifths          Int? // fifths of the head palpable above the brim (5 high → 0 engaged)
  pulseBpm               Int?
  systolicBp             Int?
  diastolicBp            Int?
  temperatureC           Float?
  urineOutputMl          Int?
  notes                  String?
  createdAt              DateTime @default(now())

  partograph Partograph @relation(fields: [partographId], references: [id])

  @@index([partographId])
}

// ---------------------------------------------------------------------
// Telemedicine (spec §82–83, docs/13 §9) — remote consultations. The API
// models the consultation lifecycle (booking → in progress → completed /
// cancelled / missed) with a join link placeholder; the actual video/phone
// transport is a later integration behind the same endpoints.
// ---------------------------------------------------------------------

model Teleconsultation {
  id          String   @id @default(uuid())
  patientId   String
  clinicianId String?
  facilityId  String?
  mode        String   @default("VIDEO") // VIDEO | PHONE | CHAT
  status      String   @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED | MISSED
  scheduledFor DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  joinUrl     String?
  notes       String?
  outcome     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient   Patient   @relation(fields: [patientId], references: [id])
  clinician User?     @relation("TeleconsultationClinician", fields: [clinicianId], references: [id])
  facility  Facility? @relation(fields: [facilityId], references: [id])

  @@index([status])
  @@index([patientId])
  @@index([clinicianId])
}

// ---------------------------------------------------------------------
// Procurement (spec §45) — suppliers, requisitions, purchase orders.
// ---------------------------------------------------------------------

model Supplier {
  id          String   @id @default(uuid())
  facilityId  String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility Facility       @relation(fields: [facilityId], references: [id])
  orders   PurchaseOrder[]
}

model Requisition {
  id            String   @id @default(uuid())
  facilityId    String
  requestedById String?
  items         String   @default("[]") // JSON array {name, quantity, unit}
  reason        String?
  status        String   @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED | ORDERED | RECEIVED | CANCELLED
  approvedById  String?
  approvedAt    DateTime?
  approvalNote  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  facility   Facility   @relation(fields: [facilityId], references: [id])
  orders     PurchaseOrder[]
  requestedBy User?     @relation("ReqRequestedBy", fields: [requestedById], references: [id])
  approvedBy User?      @relation("ReqApprovedBy", fields: [approvedById], references: [id])
}

model PurchaseOrder {
  id            String   @id @default(uuid())
  facilityId    String
  requisitionId String?
  supplierId    String?
  supplierName  String?
  items         String   @default("[]") // JSON array {name, quantity, unit, unitPrice}
  totalAmount   Float    @default(0)
  status        String   @default("DRAFT") // DRAFT | ISSUED | APPROVED | DELIVERED | RECEIVED | CANCELLED
  issuedById    String?
  receivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  facility   Facility   @relation(fields: [facilityId], references: [id])
  requisition Requisition? @relation(fields: [requisitionId], references: [id])
  supplier   Supplier?  @relation(fields: [supplierId], references: [id])
  issuedBy   User?      @relation(fields: [issuedById], references: [id])
}

// ---------------------------------------------------------------------
// Devices & synchronization (spec §100, §104, §109, §129)
// ---------------------------------------------------------------------

model Device {
  id             String   @id @default(uuid())
  deviceId       String   @unique // client-generated stable device id
  name           String
  platform       String   // WINDOWS | ANDROID | IOS | WEB | PWA
  facilityId     String?
  assignedUserId String?
  // Device lifecycle (spec §109, docs/21): new devices self-register as PENDING
  // and are refused sync until an administrator approves them (enroll). Sync is
  // enforced server-side — a SUSPENDED/BLOCKED/LOST/STOLEN/RETIRED device gets a
  // 403 and cannot push mutations.
  status         String   @default("ACTIVE") // PENDING | ACTIVE | LOST | STOLEN | SUSPENDED | RETIRED | BLOCKED
  // Enrollment audit: who approved this device and when (PENDING → ACTIVE).
  enrolledAt     DateTime?
  enrolledById   String?
  // Admin-supplied reason for the last suspension/block (shown in the device table).
  blockReason    String?
  // Remote logout (docs/21 §3): an admin can void this device's current session
  // without de-enrolling it. The device learns on its next server contact that
  // remoteLogoutAt is newer than its cached session and force-logs out.
  remoteLogoutAt DateTime?
  lastSyncAt     DateTime?
  lastSeenAt     DateTime?
  softwareVersion String?
  createdAt      DateTime @default(now())

  facility Facility? @relation(fields: [facilityId], references: [id])
  user     User?     @relation("DeviceUser", fields: [assignedUserId], references: [id])
}

model MutationLog {
  id              String   @id @default(uuid())
  transactionId   String   @unique // client-generated transaction id
  deviceId        String?
  // Facility the mutation belongs to (docs/16 §1): stamped from the acting
  // user's facility (or payload fallback) when applied, and from the entity
  // when captured at an edge. Lets a multi-facility district edge run
  // facility-scoped relay instances (relay.ts facilityId filter) instead of
  // one relay pushing every facility's work.
  facilityId      String?
  entityType      String
  entityId        String?
  operation       String   // CREATE | UPDATE
  payload         String   // JSON
  idempotencyKey  String?
  clientTimestamp DateTime
  serverTimestamp DateTime @default(now())
  status          String   @default("PENDING") // PENDING | PROCESSED | FAILED | CONFLICT
  retryCount      Int      @default(0)
  error           String?
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------
// Sync conflicts (docs/15 §4, spec §101–103, §166) — a targeted update
// (e.g. a lab result) arrived with a baseVersion older than the entity's
// current server state. Both versions are preserved here for human review;
// clinical information is never silently discarded. Resolution is explicit:
// keep the server version, apply the client version, or mark reviewed.
// ---------------------------------------------------------------------
model SyncConflict {
  id             String   @id @default(uuid())
  transactionId  String   @unique // the mutation that conflicted
  deviceId       String?
  entityType     String   // e.g. "labOrder"
  entityId       String   // the entity both versions claim
  operation      String   // e.g. "RESULT"
  clientUserId   String?  // actor who sent the stale update (re-applied on keep_client)
  facilityId     String?
  serverVersion  String   // JSON: server state at detection (the row that won)
  clientVersion  String   // JSON: the incoming stale payload (preserved, §166)
  status         String   @default("OPEN") // OPEN | RESOLVED_KEEP_CLIENT | RESOLVED_KEEP_SERVER | RESOLVED_MANUAL
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([facilityId, createdAt])
}

// ---------------------------------------------------------------------
// Public facility self-registration (spec §6, §170) — applications await
// national/regional review before a Facility record is created.
// ---------------------------------------------------------------------

model FacilityApplication {
  id           String   @id @default(uuid())
  name         String
  type         String
  ownership    String
  regionId     String
  districtId   String
  address      String?
  telephone    String?
  email        String?
  contactName  String?
  services     String   @default("[]") // JSON array of service codes
  reason       String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  region   Region   @relation(fields: [regionId], references: [id])
  district District @relation(fields: [districtId], references: [id])
}

// ---------------------------------------------------------------------
// Audit (spec §67) — never silently overwrite clinical history
// ---------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorEmail  String?
  role        String?
  action      String   // e.g. patient.create, patient.merge, appointment.book
  entityType  String?
  entityId    String?
  facilityId  String?
  deviceId    String?
  ip          String?
  before      String?
  after       String?
  reason      String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------
// Runtime system configuration (admin-editable; see docs/24). Environment
// variables are the boot defaults — once a row exists here its value wins, so
// API keys and gateway settings can be changed from the admin UI without a
// restart. Secret rows are masked in API responses and never written to the
// audit trail. value '' explicitly disables (empty string, not null).
// ---------------------------------------------------------------------

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. sms.smsonlinegh.apiKey
  value       String   @default("") // '' = unset/disabled; env fallback only when NO row exists
  secret      Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------
// Editable Ghana EPI immunization schedule (docs/24) — seeded from
// schedule.ts defaults; DB rows override the defaults for matching
// vaccine+dose, so the schedule can be edited from the admin UI.
// ---------------------------------------------------------------------

model EpiScheduleItem {
  id           String   @id @default(uuid())
  vaccine      String
  dose         String
  label        String
  description  String
  ageDays      Int? // due age from birth (child doses) — XOR with intervalDays
  intervalDays Int? // due offset from the previous dose (repeat/adult doses)
  active       Boolean  @default(true)
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([vaccine, dose])
}

// ---------------------------------------------------------------------
// Security alerts (docs/25) — the in-app inbox for lockout / license events.
// Every dispatchSecurityAlert persists a row here (fire-and-forget), so the
// developer has a durable, searchable alert history alongside the SMS/webhook
// channels. readAt marks an alert as acknowledged in the header bell.
// ---------------------------------------------------------------------

model SecurityAlert {
  id        String   @id @default(uuid())
  event     String   // lockout | license.activate | license.deactivate | license.expiring | license.expired | digest | test
  severity  String   @default("info") // info | warning | critical — color-coded in the inbox UI
  title     String
  message   String
  payload   String?  // JSON — the full SecurityAlertPayload
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/**
 * Outbound alert delivery retry queue (docs/25) — a failed email/SMS dispatch
 * is persisted here and retried with exponential backoff by the retry sweep so
 * a transient gateway outage never silently loses an alert. Permanent failures
 * (unrecognised number, gateway never configured) are not queued.
 */
model AlertDelivery {
  id            String    @id @default(uuid())
  channel       String    // 'email' | 'sms' | 'whatsapp' | 'webhook'
  to            String
  subject       String?   // email only
  message       String
  // Security-alert event this delivery belongs to (e.g. 'lockout', 'digest') —
  // links retry-queue rows to their inbox alert for the detail drawer.
  event         String?
  // Gateway message/batch id — lets the delivery-status webhook resolve this
  // row to delivered/failed without re-dispatching (docs/25).
  messageId     String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([deliveredAt])
  @@index([nextAttemptAt])
  @@index([event])
}

/**
 * National integration delivery queue (docs/08 §3) — one queue per adapter
 * (DHIMS2, SORMAS, …) so a failure on one never blocks another (spec §128).
 * Each submission is idempotent via its idempotencyKey (one logical submission
 * per period/org-unit/range) and retried with exponential backoff by the
 * integration sweep. The row is the reconciliation record: payload as sent,
 * remote acknowledgement id, attempt history and final status.
 */
model IntegrationDelivery {
  id             String    @id @default(uuid())
  adapter        String    // 'dhims2' | 'sormas' (one independent queue per adapter)
  status         String    @default("PENDING") // PENDING | DELIVERED | FAILED
  idempotencyKey String    @unique // one submission per logical unit (period/org-unit, case range)
  payload        String    // JSON payload as sent to the upstream
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  remoteId       String?   // upstream acknowledgement id (reconciliation)
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([adapter, status, nextAttemptAt])
}

/**
 * Scheduled report subscription (spec §149, docs/14 §5) — an authorised
 * recipient list, a cadence, and a scope snapshot taken at creation so the
 * schedule keeps working even if the creator's role changes. The report sweep
 * computes the period's report live and emails it to the recipients.
 */
model ScheduledReport {
  id           String   @id @default(uuid())
  name         String
  reportType   String   // 'summary' | 'completeness' | 'anomalies'
  cadence      String   // daily | weekly | monthly | quarterly | annual
  runTime      String   // HH:MM (24h)
  dayOfWeek    Int?     // weekly: 0=Sunday .. 6=Saturday
  dayOfMonth   Int?     // monthly/quarterly/annual: 1..31 (clamped)
  recipients   String   // comma-separated authorised email addresses
  groupBy      String   @default("none") // none | facility | district | region

  // Scope snapshot at creation (docs/14) — aggregate-only report scope.
  scope        String   // NATIONAL | REGIONAL | DISTRICT | FACILITY
  facilityId   String?
  regionId     String?
  districtId   String?

  active       Boolean  @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime
  lastStatus   String?  // sent | skipped | failed
  lastError    String?
  createdById  String?
  createdAt    DateTime @default(now())

  createdBy    User?          @relation(fields: [createdById], references: [id])
  deliveries   ReportDelivery[]

  @@index([active, nextRunAt])
}

/** One scheduled-report run — who it went to, when, and the outcome. */
model ReportDelivery {
  id            String    @id @default(uuid())
  scheduleId    String
  reportType    String
  periodFrom    DateTime
  periodTo      DateTime
  recipients    String
  status        String    // sent | skipped | failed
  note          String?
  messageId     String?
  runAt         DateTime  @default(now())

  // Retry bookkeeping (docs/14 §5): failed/skipped runs are retried with
  // exponential backoff by the report retry sweep until reports.retryMaxAttempts
  // (default 4) — mirroring the AlertDelivery retry sweep (docs/25).
  attempts      Int       @default(0)
  nextAttemptAt DateTime?

  schedule ScheduledReport @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, runAt])
  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------
// Drug & Disease Reference Database
// Comprehensive medicines list with uses, dosages, contraindications,
// and disease associations for clinical decision support.
// ---------------------------------------------------------------------

model Drug {
  id              String   @id @default(uuid())
  name            String   @unique // e.g. "Paracetamol"
  genericName     String?  // e.g. "Acetaminophen"
  brandNames      String?  // comma-separated, e.g. "Panadol, Tylenol"
  category        String   // ANALGESIC | ANTIBIOTIC | ANTIMALARIAL | ANTIRETROVIRAL | CARDIOVASCULAR | ENDOCRINE | GASTROINTESTINAL | RESPIRATORY | NEUROLOGICAL | DERMATOLOGICAL | OPHTHALMIC | VACCINE | ANTIFUNGAL | ANTIPARASITIC | HORMONE | VITAMIN | OTHER
  dosageForm      String?  // TABLET | CAPSULE | SYRUP | INJECTION | SUSPENSION | CREAM | OINTMENT | DROPS | INHALER | SUPPOSITORY | PATCH | GEL | SOLUTION | POWDER | GRANULES
  strength        String?  // e.g. "500mg", "10mg/ml"
  manufacturer    String?
  countryOfOrigin String?
  whoEssential    Boolean  @default(false) // WHO Model List of Essential Medicines
  ghanaEssential  Boolean  @default(false) // Ghana Essential Medicines List
  prescriptionOnly Boolean @default(false) // Prescription Only Medicine (POM)
  otc             Boolean  @default(false) // Over The Counter
  controlledSchedule String? // SCHEDULE_1 | SCHEDULE_2 | SCHEDULE_3 | SCHEDULE_4 | null if not controlled
  adultDose       String?  // e.g. "500mg - 1g q6h"
  pediatricDose   String?  // e.g. "10-15mg/kg q4-6h"
  maxDailyDose    String?  // e.g. "4g/day"
  route           String?  // ORAL | IV | IM | SC | TOPICAL | RECTAL | INHALATION | OPHTHALMIC | SUBLINGUAL
  frequency       String?  // q4h | q6h | q8h | q12h | ONCE_DAILY | TWICE_DAILY | THREE_TIMES_DAILY | AS_NEEDED
  duration        String?  // e.g. "5-7 days"
  mechanism       String?  // Brief mechanism of action
  sideEffects     String?  // comma-separated common side effects
  contraindications String? // comma-separated contraindications
  drugInteractions String?  // notable drug interactions
  pregnancyCategory String? // A | B | C | D | X | null
  storageConditions String? // e.g. "Store below 25°C"
  shelfLife       String?  // e.g. "36 months"
  description     String?  // clinical description and notes
  status          String   @default("ACTIVE") // ACTIVE | DISCONTINUED | WITHDRAWN
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  diseaseLinks DrugDiseaseLink[]

  @@index([category])
  @@index([whoEssential])
  @@index([ghanaEssential])
}

model Disease {
  id              String   @id @default(uuid())
  name            String   @unique // e.g. "Malaria"
  icdCode         String?  // ICD-10 code, e.g. "B54"
  category        String   // INFECTIOUS | NON_COMMUNICABLE | MATERNAL | NEOPLASM | INJURY | NUTRITIONAL | MENTAL | OTHER
  subCategory     String?  // e.g. "Vector-borne", "Respiratory"
  type            String?  // BACTERIAL | VIRAL | PARASITIC | FUNGAL | AUTOIMMUNE | METABOLIC | TRAUMATIC | DEGENERATIVE | OTHER
  symptoms        String?  // comma-separated common symptoms
  transmission   String?  // how it spreads
  incubationPeriod String? // e.g. "7-30 days"
  severity        String   @default("MODERATE") // MILD | MODERATE | SEVERE | LIFE_THREATENING
  prevention      String?  // prevention methods
  diagnosis       String?  // diagnostic approach
  complications   String?  // potential complications
  endemicToGhana  Boolean  @default(false)
  vaccineAvailable Boolean @default(false)
  status          String   @default("ACTIVE") // ACTIVE | ERADICATED | DECLINING
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  drugLinks DrugDiseaseLink[]

  @@index([category])
  @@index([icdCode])
  @@index([endemicToGhana])
}

model DrugDiseaseLink {
  id          String   @id @default(uuid())
  drugId      String
  diseaseId   String
  efficacy    String?  // FIRST_LINE | SECOND_LINE | ADJUNCTIVE | PALLIATIVE | PROPHYLACTIC
  dosageNote  String?  // disease-specific dosage guidance
  notes       String?  // clinical notes
  createdAt   DateTime @default(now())

  drug    Drug    @relation(fields: [drugId], references: [id], onDelete: Cascade)
  disease Disease @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@unique([drugId, diseaseId])
  @@index([drugId])
  @@index([diseaseId])
}
