{
  "buildCommand": "npm install -w apps/web && npm run build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/404.json" },
    { "source": "/((?!assets/|api/|fallback-data\\.json|.*\\..*).*)", "destination": "/index.html" }
  ]
}
