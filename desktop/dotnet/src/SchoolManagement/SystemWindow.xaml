<Window x:Class="SchoolManagement.SystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GIHM-HIS — by ShaComputeC"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Background="#0f1b2d"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <!-- Status bar at top -->
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: mode indicator + close button -->
        <Border Grid.Row="0" Background="#0a1424">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock x:Name="ModeLabel" Text="📴 Offline" Foreground="#88aacc"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="  —  " Foreground="#334455" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UserLabel" Text="" Foreground="#667788"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="by ShaComputeC" Foreground="#445566" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 -->
        <wv:WebView2 x:Name="WebView" Grid.Row="1"
                      NavigationStarting="WebView_NavigationStarting"
                      CoreWebView2InitializationCompleted="WebView_CoreWebView2InitializationCompleted"
                      AllowExternalDrop="True"/>
    </Grid>
</Window>
