<Window x:Class="SchoolManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIHM-HIS — by ShaComputeC"
        Width="820" Height="580"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Closing="MainWindow_Closing"
        Background="#0f1b2d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Branding panel -->
        <Border Grid.Column="0" Background="#0f1b2d">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="60,0">
                    <Image x:Name="LogoImage" Width="64" Height="64"
                           HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,20"/>

                    <TextBlock Text="GIHM-HIS" Foreground="White" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <TextBlock Foreground="#7788aa" FontSize="13" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Margin="0,0,0,30">
                        Ghana Integrated Health Management<LineBreak/>
                        &amp; Hospital Information System
                    </TextBlock>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#1a3050" CornerRadius="8" Width="34" Height="34"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#x1f3db;" FontSize="16" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="National Facility Registry" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="16 regions · 261 districts" Foreground="#556677" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#1a3050" CornerRadius="8" Width="34" Height="34">
                                <TextBlock Text="&#x1f4f4;" FontSize="16" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Offline-first architecture" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Works without internet · Syncs when online" Foreground="#556677" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#1a3050" CornerRadius="8" Width="34" Height="34">
                                <TextBlock Text="&#x1f512;" FontSize="16" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="HIPAA-ready security" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="RBAC · Audit trails · Encryption" Foreground="#556677" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1a3050" CornerRadius="8" Width="34" Height="34">
                                <TextBlock Text="&#x1f4ca;" FontSize="16" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="300+ clinical modules" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="OPD · ER · Pharmacy · Lab · Theatre" Foreground="#556677" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Background="#0a1424" Padding="60,16">
                    <StackPanel>
                        <TextBlock Text="DEMO ACCOUNTS" Foreground="#cc8800" FontSize="9"
                                   FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Foreground="#667788" FontSize="11" FontFamily="Consolas" LineHeight="20">
                            <Run Text="admin@demo.gh" Foreground="#88aacc" FontWeight="SemiBold"/><Run Text="  /  "/><Run Text="Demo@123" Foreground="#556677"/><LineBreak/>
                            <Run Text="hospital@demo.gh" Foreground="#88aacc" FontWeight="SemiBold"/><Run Text="  /  "/><Run Text="Demo@123" Foreground="#556677"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT: Login / Settings / Mode panels -->
        <Border Grid.Column="1" Background="#141e30">
            <Grid>
                <!-- Login form -->
                <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" Margin="40,0">
                    <TextBlock Text="Welcome back" Foreground="White" FontSize="26" FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Sign in to your account" Foreground="#667788" FontSize="13"
                               Margin="0,0,0,32"/>

                    <TextBlock Text="Email or Username" Foreground="#667788" FontSize="11"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="#0a1424" CornerRadius="8" BorderBrush="#1e3050" BorderThickness="1">
                        <TextBox x:Name="EmailBox" Height="42" FontSize="14" Padding="14,10"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 CaretBrush="White" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Password" Foreground="#667788" FontSize="11"
                               FontWeight="SemiBold" Margin="0,18,0,8"/>
                    <Border Background="#0a1424" CornerRadius="8" BorderBrush="#1e3050" BorderThickness="1">
                        <PasswordBox x:Name="PasswordBox" Height="42" FontSize="14" Padding="14,10"
                                     Background="Transparent" Foreground="White" BorderThickness="0"/>
                    </Border>

                    <TextBlock x:Name="ErrorText" Text="" Foreground="#dc2626" FontSize="11"
                               Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                    <Button x:Name="SignInButton" Height="46" Margin="0,24,0,0"
                            Background="#16a34a" Foreground="White" FontSize="14"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                            Click="SignIn_Click" FontFamily="Segoe UI">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#15803d"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#2a3a5a"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Grid Margin="0,24,0,0">
                        <Line X1="0" X2="1" Stroke="#1e3050" StrokeThickness="1"
                              VerticalAlignment="Center" Width="170" HorizontalAlignment="Left"/>
                        <TextBlock Text="or" Foreground="#445566" FontSize="11"
                                   HorizontalAlignment="Center" Background="#141e30" Padding="10,0"/>
                        <Line X1="0" X2="1" Stroke="#1e3050" StrokeThickness="1"
                              VerticalAlignment="Center" Width="170" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border x:Name="OfflineButton" Background="#0a1424" CornerRadius="10"
                            Padding="16" Margin="0,16,0,0" Cursor="Hand"
                            BorderBrush="#1e3050" BorderThickness="1"
                            PreviewMouseLeftButtonDown="OfflineLogin_Click"
                            MouseEnter="OfflineBtn_Enter" MouseLeave="OfflineBtn_Leave">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#2a1a0a" CornerRadius="8" Width="40" Height="40" Margin="0,0,14,0">
                                <TextBlock Text="&#x1f4f4;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Continue offline with cached data"
                                           Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="No internet needed — work locally and sync later"
                                           Foreground="#556677" FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsButton" Background="Transparent" CornerRadius="8"
                            Padding="10,8" Margin="0,12,0,0" Cursor="Hand"
                            PreviewMouseLeftButtonDown="Settings_Click"
                            MouseEnter="SettingsBtn_Enter" MouseLeave="SettingsBtn_Leave">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#x2699;" FontSize="13" Foreground="#667788"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Settings — Server, proxy, cache" Foreground="#667788"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Settings panel -->
                <StackPanel x:Name="SettingsPanel" VerticalAlignment="Center" Margin="40,0" Visibility="Collapsed">
                    <TextBlock Text="Settings" Foreground="White" FontSize="24" FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Configure connection and sync options" Foreground="#667788"
                               FontSize="12" Margin="0,0,0,28"/>

                    <TextBlock Text="Server URL" Foreground="#667788" FontSize="11"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="#0a1424" CornerRadius="8" BorderBrush="#1e3050" BorderThickness="1">
                        <TextBox x:Name="ServerUrlBox" Height="40" FontSize="13" Padding="14,8"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 CaretBrush="White" VerticalContentAlignment="Center"
                                 Text="http://localhost:5173"/>
                    </Border>
                    <TextBlock Text="Local dev server or your deployed URL" Foreground="#445566"
                               FontSize="10" Margin="0,4,0,0"/>

                    <TextBlock Text="Local Data Cache" Foreground="#667788" FontSize="11"
                               FontWeight="SemiBold" Margin="0,20,0,6"/>
                    <Border Background="#0a1424" CornerRadius="10" Padding="14" BorderBrush="#1e3050" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="CacheSizeText" Text="Cache size: Calculating..."
                                           Foreground="White" FontSize="12"/>
                                <TextBlock Text="IndexedDB + service worker cache"
                                           Foreground="#556677" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clear" Height="30" Padding="14,0"
                                    Background="#dc2626" Foreground="White" FontSize="11"
                                    BorderThickness="0" Cursor="Hand" Click="ClearCache_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#b91c1c"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="#0a1424" CornerRadius="10" Padding="14" Margin="0,12,0,0"
                            BorderBrush="#1e3050" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Auto-sync when online" Foreground="White"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Sync pending changes when connected"
                                           Foreground="#556677" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoSyncCheck" Grid.Column="1" IsChecked="True"
                                      Foreground="#16a34a" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Margin="0,24,0,0" Height="40" Background="#1e3050"
                            Foreground="White" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="SettingsBack_Click" Content="&#x2190; Back to login">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2a4060"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Mode selector -->
                <StackPanel x:Name="ModePanel" VerticalAlignment="Center" Margin="30,0" Visibility="Collapsed">
                    <TextBlock Text="Choose connection mode" Foreground="White" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="WelcomeText" Text="" Foreground="#667788" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,0,0,28"/>

                    <Border x:Name="OnlineCard" Background="#0a1424" CornerRadius="10" Padding="18"
                            Margin="0,0,0,10" Cursor="Hand" PreviewMouseLeftButtonDown="ModeOnline_Click"
                            BorderBrush="#1e3050" BorderThickness="1"
                            MouseEnter="ModeCard_Enter" MouseLeave="ModeCard_Leave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#0a2a1a" CornerRadius="10" Width="48" Height="48"
                                    Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="&#x1f310;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Online — Local Server" Foreground="White"
                                           FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Connects to your local dev server"
                                           Foreground="#556677" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="&#x2192;" Foreground="#445566" FontSize="18"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border x:Name="OfflineCard" Background="#0a1424" CornerRadius="10" Padding="18"
                            Margin="0,0,0,10" Cursor="Hand" PreviewMouseLeftButtonDown="ModeOffline_Click"
                            BorderBrush="#1e3050" BorderThickness="1"
                            MouseEnter="ModeCard_Enter" MouseLeave="ModeCard_Leave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#2a1a0a" CornerRadius="10" Width="48" Height="48"
                                    Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="&#x1f4f4;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Offline — Work Without Internet" Foreground="White"
                                           FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Runs from bundled files — no internet needed"
                                           Foreground="#556677" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="&#x2192;" Foreground="#445566" FontSize="18"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ModeStatusText" Text="" Foreground="#556677" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>

                    <Border x:Name="BackToLoginBtn" Background="Transparent" CornerRadius="8"
                            Padding="10,8" Margin="0,8,0,0" Cursor="Hand"
                            HorizontalAlignment="Center"
                            PreviewMouseLeftButtonDown="BackToLogin_Click"
                            MouseEnter="SettingsBtn_Enter" MouseLeave="SettingsBtn_Leave">
                        <TextBlock Text="&#x2190; Back to login" Foreground="#667788" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
