<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\..\..\desktop\assets\icons\icon.ico</ApplicationIcon>
    <AssemblyName>GIHM-HIS</AssemblyName>
    <RootNamespace>SchoolManagement</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ShaComputeC</Authors>
    <Company>GIHM-HIS</Company>
    <Product>GIHM-HIS</Product>
    <Description>Ghana Integrated Health Management &amp; Hospital Information System</Description>
    <Copyright>© 2026 GIHM-HIS — Developed by ShaComputeC</Copyright>

    <!-- Self-contained single-file publish -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\desktop\assets\app-icon.png">
      <Link>assets\app-icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\desktop\assets\icons\icon.ico">
      <Link>assets\icon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\apps\web\dist\**\*" Exclude="..\..\..\..\apps\web\dist\sw.js;..\..\..\..\apps\web\dist\workbox-*">
      <Link>web-dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
